# Modelo das variaveis lidas pelo docker-compose. Copie para `.env` e troque os
# valores. O `.env` real fica fora do git (ver .gitignore) — este arquivo existe
# so para documentar quais chaves precisam existir.
#
#   cp .env.example .env
#
# Em producao nada disso vira arquivo: as mesmas chaves saem de um cofre
# (Key Vault, Secrets Manager) injetado como variavel de ambiente.

# --- Banco de dados ---------------------------------------------------------
# Politica do SQL Server: 8+ caracteres com maiuscula, minuscula e digito.
MSSQL_SA_PASSWORD=troque-esta-senha

# --- Fila -------------------------------------------------------------------
RABBITMQ_USER=sabemi
RABBITMQ_PASS=troque-esta-senha

# --- Assinatura do token do painel ------------------------------------------
# HMAC-SHA256 exige no minimo 32 caracteres. Gere um valor aleatorio:
#   openssl rand -base64 48
JWT_CHAVE_ASSINATURA=troque-por-um-valor-aleatorio-de-no-minimo-32-caracteres

# --- Usuarios de demonstracao do painel -------------------------------------
# Existem apenas para o desafio rodar sem IdP. Em producao a secao inteira e
# substituida por Autenticacao__Authority apontando para o IdP corporativo.
PAINEL_OPERADOR_LOGIN=operador
PAINEL_OPERADOR_SENHA=troque-esta-senha
PAINEL_ADMIN_LOGIN=admin
PAINEL_ADMIN_SENHA=troque-esta-senha

# --- Credenciais do banco parceiro (webhook) --------------------------------
# A ApiKey identifica o parceiro; o segredo assina o corpo em HMAC-SHA256.
WEBHOOK_API_KEY=troque-esta-api-key
WEBHOOK_SEGREDO=troque-este-segredo
